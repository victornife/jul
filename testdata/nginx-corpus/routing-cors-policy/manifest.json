{
  "schema_version": 1,
  "id": "routing-cors-policy",
  "tier": "core",
  "description": "Routing and policy fixture covering exact and regex locations, bounded method constraints, static CORS response policy, and the documented limit_except approximation.",
  "origin": {
    "kind": "repository_authored",
    "license": "AGPL-3.0-only",
    "source": "victornife/jul#154"
  },
  "categories": [
    "core-http",
    "request-policy",
    "response-headers"
  ],
  "build_tags": [
    "importer"
  ],
  "root": "nginx/nginx.conf",
  "follow_includes": false,
  "expected_assessment": {
    "status": "ready_for_review",
    "ready": true,
    "complete": true,
    "files_read": 1,
    "sources": [
      "nginx.conf"
    ],
    "results": [
      {
        "source": "nginx.conf",
        "code": "NGX_MAIN_EVENTS",
        "class": "informational",
        "risk": "operational",
        "context": "main",
        "directive": "events"
      },
      {
        "source": "nginx.conf",
        "code": "NGX_MAIN_HTTP",
        "class": "supported",
        "risk": "operational",
        "context": "main",
        "directive": "http"
      },
      {
        "source": "nginx.conf",
        "code": "NGX_HTTP_SERVER",
        "class": "supported",
        "risk": "routing",
        "context": "http",
        "directive": "server"
      },
      {
        "source": "nginx.conf",
        "code": "NGX_SERVER_LISTEN",
        "class": "supported",
        "risk": "availability",
        "context": "server",
        "directive": "listen"
      },
      {
        "source": "nginx.conf",
        "code": "NGX_SERVER_NAME",
        "class": "supported",
        "risk": "routing",
        "context": "server",
        "directive": "server_name"
      },
      {
        "source": "nginx.conf",
        "code": "NGX_SERVER_LOCATION",
        "class": "supported",
        "risk": "routing",
        "context": "server",
        "directive": "location",
        "count": 2
      },
      {
        "source": "nginx.conf",
        "code": "NGX_LOCATION_LIMIT_EXCEPT",
        "class": "approximated",
        "risk": "security",
        "context": "location",
        "directive": "limit_except"
      },
      {
        "source": "nginx.conf",
        "code": "NGX_LIMIT_EXCEPT_DENY",
        "class": "supported",
        "risk": "security",
        "context": "limit_except",
        "directive": "deny"
      },
      {
        "source": "nginx.conf",
        "code": "NGX_LOCATION_ADD_HEADER",
        "class": "supported",
        "risk": "security",
        "context": "location",
        "directive": "add_header",
        "count": 2
      },
      {
        "source": "nginx.conf",
        "code": "NGX_LOCATION_RETURN",
        "class": "supported",
        "risk": "routing",
        "context": "location",
        "directive": "return",
        "count": 2
      }
    ]
  },
  "expected_candidate": {
    "required": true,
    "contains": [
      "allowed_methods = ['GET', 'HEAD', 'OPTIONS']",
      "allowed_origins = ['https://client.test']",
      "listen = ':18084'",
      "methods = ['GET', 'HEAD']",
      "path = '/exact'",
      "server_names = ['routing.test']"
    ]
  },
  "scenarios": [
    {
      "id": "cors-exact-get",
      "safe": true,
      "request": {
        "method": "GET",
        "path": "/exact",
        "host": "routing.test",
        "headers": {
          "origin": [
            "https://client.test"
          ]
        }
      },
      "assert": [
        "status",
        "headers"
      ],
      "assert_headers": [
        "access-control-allow-origin"
      ],
      "ignore_headers": [
        "date",
        "server",
        "x-request-id"
      ],
      "reference": {
        "status": 204,
        "headers": {
          "access-control-allow-origin": [
            "https://client.test"
          ]
        }
      },
      "expected_verdict": "equivalent_for_asserted_dimensions"
    },
    {
      "id": "limit-except-post",
      "safe": true,
      "side_effect_free": true,
      "request": {
        "method": "POST",
        "path": "/exact",
        "host": "routing.test"
      },
      "assert": [
        "status"
      ],
      "reference": {
        "status": 403
      },
      "jul": {
        "status": 404
      },
      "expected_verdict": "expected_difference",
      "expected_difference_code": "NGX_LOCATION_LIMIT_EXCEPT"
    }
  ]
}
