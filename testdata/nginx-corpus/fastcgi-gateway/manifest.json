{
  "schema_version": 1,
  "id": "fastcgi-gateway",
  "tier": "core",
  "description": "Protocol-gateway fixture proving that a regex PHP location and FastCGI target translate into a strict-valid Jul candidate without claiming runtime parity.",
  "origin": {
    "kind": "repository_authored",
    "license": "AGPL-3.0-only",
    "source": "victornife/jul#154"
  },
  "categories": [
    "fastcgi",
    "protocol-gateways"
  ],
  "build_tags": [
    "importer"
  ],
  "root": "nginx/nginx.conf",
  "follow_includes": false,
  "expected_assessment": {
    "status": "ready_for_review",
    "ready": true,
    "complete": true,
    "files_read": 1,
    "sources": [
      "nginx.conf"
    ],
    "results": [
      {
        "source": "nginx.conf",
        "code": "NGX_MAIN_EVENTS",
        "class": "informational",
        "risk": "operational",
        "context": "main",
        "directive": "events"
      },
      {
        "source": "nginx.conf",
        "code": "NGX_MAIN_HTTP",
        "class": "supported",
        "risk": "operational",
        "context": "main",
        "directive": "http"
      },
      {
        "source": "nginx.conf",
        "code": "NGX_HTTP_SERVER",
        "class": "supported",
        "risk": "routing",
        "context": "http",
        "directive": "server"
      },
      {
        "source": "nginx.conf",
        "code": "NGX_SERVER_LISTEN",
        "class": "supported",
        "risk": "availability",
        "context": "server",
        "directive": "listen"
      },
      {
        "source": "nginx.conf",
        "code": "NGX_SERVER_NAME",
        "class": "supported",
        "risk": "routing",
        "context": "server",
        "directive": "server_name"
      },
      {
        "source": "nginx.conf",
        "code": "NGX_SERVER_LOCATION",
        "class": "supported",
        "risk": "routing",
        "context": "server",
        "directive": "location"
      },
      {
        "source": "nginx.conf",
        "code": "NGX_LOCATION_FASTCGI",
        "class": "supported",
        "risk": "routing",
        "context": "location",
        "directive": "fastcgi_pass"
      }
    ]
  },
  "expected_candidate": {
    "required": true,
    "contains": [
      "fastcgi_pass = '127.0.0.1:19000'",
      "listen = ':18086'",
      "path = '\\.php$'",
      "server_names = ['fastcgi.test']"
    ]
  }
}
