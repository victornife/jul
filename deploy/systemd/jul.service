[Unit]
Description=Jul NGINX-inspired HTTP edge server
Documentation=https://example.invalid/jul
After=network-online.target
Wants=network-online.target
# Crash-loop safeguard: if the unit restarts more than StartLimitBurst times
# within StartLimitIntervalSec, systemd gives up instead of looping forever.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# Reload configuration on `systemctl reload jul` (SIGHUP).
ExecStart=/usr/local/bin/jul --config /etc/jul/server.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2s

# Run as an unprivileged, dynamically-allocated system user.
DynamicUser=yes
# Allow binding to privileged ports (80/443) without full root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening: minimal filesystem and kernel surface.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes

# Editable deployment. systemd creates and owns these directories for the
# (dynamic) service user and keeps them across restarts. ProtectSystem=strict
# keeps the rest of the host read-only, but these four stay writable, so the
# admin console can apply config changes and roll back from history while
# everything else remains immutable:
#
#   /etc/jul       (ConfigurationDirectory) - server.toml the admin rewrites
#   /var/lib/jul   (StateDirectory)         - config history snapshots
#   /var/cache/jul (CacheDirectory)         - HTTP disk cache + ACME cert cache
#   /var/log/jul   (LogsDirectory)          - access-log "file" sink output
#
# Config and history can carry inline credentials, so restrict them to the
# service user only (0700). Point acme.cache_dir and the disk cache at
# /var/cache/jul, the access-log file sink at /var/log/jul, and history at
# /var/lib/jul. Seed the initial config before the first start with, e.g.:
#   install -D -m600 server.toml /etc/jul/server.toml
ConfigurationDirectory=jul
ConfigurationDirectoryMode=0700
StateDirectory=jul
StateDirectoryMode=0700
CacheDirectory=jul
LogsDirectory=jul

# Resource limits. An edge server multiplexes many sockets, so raise the
# file-descriptor ceiling well above the default and cap thread/PID growth.
LimitNOFILE=65536
TasksMax=4096
# Optional memory/CPU caps - uncomment and tune to your host's capacity.
# MemoryMax=512M
# CPUQuota=200%

[Install]
WantedBy=multi-user.target
