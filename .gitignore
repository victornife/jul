# Binaries (anchored to repo root so the cmd/jul/ source dir is NOT ignored)
/jul
/jul.exe
/jul_test.exe
/dist/

# Go test binaries (`go test -c` / ad-hoc test builds)
*.test
*.test.exe

# Rust example build output
examples/rust-proxy/target/
examples/rust-proxy/Cargo.lock
examples/rust-proxy/app
examples/rust-proxy/app.exe
examples/rust-proxy/app.pdb

# Test artifacts
*.out
coverage.txt

# Local runtime data (config-history snapshots, access logs, ...)
/jul-data/
/tmp/
*.pid
*.log

# Managed-authority sidecar artifacts a local `jul serve` run creates next to
# whatever config file it was pointed at (ADR 0019 §11.2/§17.4) — never meant
# to be committed alongside a testdata fixture.
*.managed-baseline.json
*.managed-baseline.snapshot
*.pending-restart.json
*.pending-restart.bak

# OS / editor
.DS_Store
*.swp

# Local burn-in / soak build artifacts
/jul-full.exe
/jul-new.exe
/burn-in-load.exe
/burn-in-load-test.exe

# Stray root node_modules — the Console's real deps live in
# internal/admin/ui/node_modules (ignored by that dir's .gitignore).
# A root-level node_modules only appears if pnpm is run from the repo root
# by mistake; never track it.
/node_modules/

# Python bytecode from scripts/
__pycache__/
*.pyc
