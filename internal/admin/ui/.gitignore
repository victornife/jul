# Console v2 SPA — local-only artifacts. The built bundle is NOT here; it is
# committed under ../assets/dist for Node-free `go build`. Everything below is
# regenerated by `pnpm install` / `pnpm build` and must never be committed.

# Dependencies (restored via the committed pnpm-lock.yaml)
node_modules/

# Tool caches
.vite/
.eslintcache
*.tsbuildinfo

# Test / coverage output
coverage/
