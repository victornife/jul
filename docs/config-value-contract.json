      "active_when": "always"
    },
    {
      "go_field": "UpstreamConfig.MaxFails",
      "path": "upstreams[].max_fails",
      "kind": "integer",
      "constraint": "non-negative",
      "zero_semantics": "omitted/zero defaults to 3",
      "active_when": "always"
    },
    {
      "go_field": "UpstreamConfig.Strategy",
      "path": "upstreams[].strategy",
      "kind": "enum",
      "constraint": "exact lowercase enum",
      "zero_semantics": "omitted selects the documented default where supported",
      "active_when": "upstream configured",
      "allowed": [
        "round_robin",
        "weighted_round_robin",
        "least_conn"
      ]
    },
    {
      "go_field": "UpstreamServer.Weight",
      "path": "upstreams[].servers[].weight",
      "kind": "integer",
      "constraint": "positive when explicitly materialized; zero is treated as omitted for direct struct callers",
      "zero_semantics": "omitted/zero defaults to 1",
      "active_when": "always"
    },
    {
      "go_field": "WAFConfig.BlockStatus",
      "path": "waf.block_status / servers[].locations[].waf.block_status",
      "kind": "http_status",
      "constraint": "100..599 effective",
      "zero_semantics": "omitted/zero defaults to 403",
      "active_when": "WAF enabled"
    },
    {
      "go_field": "WAFConfig.Mode",
      "path": "waf.mode / servers[].locations[].waf.mode",
      "kind": "enum",
      "constraint": "exact lowercase enum",
      "zero_semantics": "omitted selects the documented default where supported",
      "active_when": "WAF enabled",
      "allowed": [
        "block",
        "detect"
      ]
    },
    {
      "go_field": "WAFConfig.Paranoia",
      "path": "waf.paranoia / servers[].locations[].waf.paranoia",
      "kind": "integer",
      "constraint": "0 or 1..4; non-zero requires CRS",
      "zero_semantics": "0 selects the CRS default",
      "active_when": "WAF enabled"
    },
    {
      "go_field": "WAFConfig.RequestBodyLimit",
      "path": "waf.request_body_limit / servers[].locations[].waf.request_body_limit",
      "kind": "size",
      "constraint": "non-negative",
      "zero_semantics": "omitted/zero defaults to 128 KiB",
      "active_when": "WAF enabled"
    }
  ]
}
