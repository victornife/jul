--- a/internal/dbg709/dbg.go
+++ b/internal/dbg709/dbg.go
@@ -0,0 +1,58 @@
+package dbg709
+
+import (
+	"fmt"
+	"os"
+	"runtime"
+	"sync"
+	"sync/atomic"
+	"time"
+)
+
+type ctr struct{ made, closed, collected atomic.Int64 }
+
+var (
+	mu   sync.Mutex
+	ctrs = map[string]*ctr{}
+)
+
+func get(k string) *ctr {
+	mu.Lock()
+	defer mu.Unlock()
+	c := ctrs[k]
+	if c == nil {
+		c = &ctr{}
+		ctrs[k] = c
+	}
+	return c
+}
+
+func Track[T any](kind string, p *T) {
+	c := get(kind)
+	c.made.Add(1)
+	runtime.AddCleanup(p, func(c *ctr) { c.collected.Add(1) }, c)
+}
+
+func Closed(kind string) { get(kind).closed.Add(1) }
+
+var once sync.Once
+
+func Start() {
+	once.Do(func() {
+		go func() {
+			for range time.Tick(3 * time.Second) {
+				runtime.GC()
+				runtime.GC()
+				var ms runtime.MemStats
+				runtime.ReadMemStats(&ms)
+				mu.Lock()
+				s := fmt.Sprintf("DBG709 heap=%dMiB", ms.HeapAlloc>>20)
+				for k, c := range ctrs {
+					s += fmt.Sprintf(" %s(made=%d closed=%d gc=%d)", k, c.made.Load(), c.closed.Load(), c.collected.Load())
+				}
+				mu.Unlock()
+				fmt.Fprintln(os.Stderr, s)
+			}
+		}()
+	})
+}
