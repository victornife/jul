{
  "schema_version": 1,
  "pack_id": "jul-waf-default-v1",
  "description": "Synthetic legitimate requests, encoding/parser boundaries, and malicious attack controls for OWASP CRS v4.25.0 and Coraza v3.8.1",
  "fixtures": [
    {
      "id": "legit-get-catalog",
      "category": "legitimate",
      "description": "Standard GET catalog query with pagination and sorting parameters",
      "method": "GET",
      "host": "portal.example.test",
      "path": "/products?page=2&sort=name_asc",
      "headers": {
        "Accept": "text/html,application/xhtml+xml",
        "User-Agent": "Mozilla/5.0 (X11; Linux x86_64) JulFixture/1.0"
      },
      "expected_outcome": "clean",
      "expected_status": 200,
      "expected_origin_reached": true
    },
    {
      "id": "legit-form-contact",
      "category": "legitimate",
      "description": "URL-encoded POST contact form with normal prose",
      "method": "POST",
      "host": "portal.example.test",
      "path": "/contact",
      "headers": {
        "Content-Type": "application/x-www-form-urlencoded",
        "User-Agent": "Mozilla/5.0 JulFixture/1.0"
      },
      "body": "name=Alice+Smith&subject=Service+inquiry&message=Hello+team%2C+we+would+like+to+schedule+a+review.",
      "expected_outcome": "clean",
      "expected_status": 200,
      "expected_origin_reached": true
    },
    {
      "id": "legit-json-api",
      "category": "legitimate",
      "description": "Structured JSON POST payload with nested array and numbers",
      "method": "POST",
      "host": "app.example.test",
      "path": "/api/items",
      "headers": {
        "Accept": "application/json",
        "Content-Type": "application/json",
        "User-Agent": "Mozilla/5.0 JulFixture/1.0"
      },
      "body": "{\"title\":\"Quarterly Report\",\"tags\":[\"finance\",\"operations\"],\"count\":12,\"published\":true}",
      "expected_outcome": "clean",
      "expected_status": 200,
      "expected_origin_reached": true
    },
    {
      "id": "legit-multipart-upload",
      "category": "legitimate",
      "description": "Multipart form-data file upload with text attachment and metadata field",
      "method": "POST",
      "host": "app.example.test",
      "path": "/api/upload",
      "headers": {
        "Content-Type": "multipart/form-data; boundary=----JulWAFFixtureBoundary7MA4YWxkTrZu0gW",
        "User-Agent": "Mozilla/5.0 JulFixture/1.0"
      },
      "body": "------JulWAFFixtureBoundary7MA4YWxkTrZu0gW\r\nContent-Disposition: form-data; name=\"description\"\r\n\r\nQuarterly project notes upload\r\n------JulWAFFixtureBoundary7MA4YWxkTrZu0gW\r\nContent-Disposition: form-data; name=\"file\"; filename=\"notes.txt\"\r\nContent-Type: text/plain\r\n\r\nSynthetic plain-text attachment content for WAF regression verification.\r\n------JulWAFFixtureBoundary7MA4YWxkTrZu0gW--\r\n",
      "expected_outcome": "clean",
      "expected_status": 200,
      "expected_origin_reached": true
    },
    {
      "id": "legit-utf8-boundary",
      "category": "boundary",
      "description": "URL-encoded international UTF-8 characters within request body limit",
      "method": "POST",
      "host": "portal.example.test",
      "path": "/profile",
      "headers": {
        "Content-Type": "application/x-www-form-urlencoded",
        "User-Agent": "Mozilla/5.0 JulFixture/1.0"
      },
      "body": "display_name=Victor+Niharra&city=Madrid+Espa%C3%B1a&bio=Caf%C3%A9+and+distributed+systems",
      "expected_outcome": "clean",
      "expected_status": 200,
      "expected_origin_reached": true
    },
    {
      "id": "attack-sqli-query",
      "category": "malicious",
      "description": "Classic boolean SQL injection probe in query parameter",
      "method": "GET",
      "host": "app.example.test",
      "path": "/products?id=1%27%20OR%20%271%27%3D%271",
      "headers": {
        "User-Agent": "Mozilla/5.0 JulFixture/1.0"
      },
      "expected_outcome": "interrupted_request",
      "expected_status": 403,
      "expected_origin_reached": false,
      "expected_rule_ids": [942100]
    },
    {
      "id": "attack-xss-form",
      "category": "malicious",
      "description": "Reflected/stored script tag XSS payload in form body",
      "method": "POST",
      "host": "app.example.test",
      "path": "/contact",
      "headers": {
        "Content-Type": "application/x-www-form-urlencoded",
        "User-Agent": "Mozilla/5.0 JulFixture/1.0"
      },
      "body": "name=attacker&message=%3Cscript%3Ealert%28document.cookie%29%3C%2Fscript%3E",
      "expected_outcome": "interrupted_request",
      "expected_status": 403,
      "expected_origin_reached": false,
      "expected_rule_ids": [941100]
    },
    {
      "id": "attack-rce-json",
      "category": "malicious",
      "description": "Unix shell command injection probe inside JSON field",
      "method": "POST",
      "host": "app.example.test",
      "path": "/api/items",
      "headers": {
        "Content-Type": "application/json",
        "User-Agent": "Mozilla/5.0 JulFixture/1.0"
      },
      "body": "{\"title\":\"; $(whoami) && id\",\"count\":1}",
      "expected_outcome": "interrupted_request",
      "expected_status": 403,
      "expected_origin_reached": false
    },
    {
      "id": "attack-scanner-ua",
      "category": "malicious",
      "description": "Known automated vulnerability scanner User-Agent header",
      "method": "GET",
      "host": "app.example.test",
      "path": "/",
      "headers": {
        "User-Agent": "sqlmap/1.7.2#stable (https://sqlmap.org)"
      },
      "expected_outcome": "interrupted_request",
      "expected_status": 403,
      "expected_origin_reached": false,
      "expected_rule_ids": [913100]
    },
    {
      "id": "boundary-malformed-json",
      "category": "boundary",
      "description": "Syntactically truncated JSON request body triggering Coraza rule 200002",
      "method": "POST",
      "host": "app.example.test",
      "path": "/api/items",
      "headers": {
        "Content-Type": "application/json",
        "User-Agent": "Mozilla/5.0 JulFixture/1.0"
      },
      "body": "{\"title\":\"unclosed",
      "expected_outcome": "interrupted_request",
      "expected_status": 400,
      "expected_origin_reached": false,
      "expected_rule_ids": [200002]
    }
  ]
}
